rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimaryAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'juanpablozonho@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidHexColor(c) {
      return c is string && c.size() == 7 && c.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidIsoDate(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidMonth(m) {
      return m is string && m.size() == 7 && m.matches('^\\d{4}-\\d{2}$');
    }

    function parentWorkspaceExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function parentWorkspaceExistsAfter(userId) {
      return existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    // --- Entity Validation Blueprints ---
    function isValidAssistantConfig(data) {
      return data.keys().hasAll(['profileId', 'modelId', 'thinkingLevel', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['profileId', 'modelId', 'thinkingLevel', 'updatedBy', 'updatedAt'])
        && data.profileId in ['economic_smart', 'ultra_lite', 'balanced', 'deep']
        && data.modelId in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite']
        && data.thinkingLevel in ['LOW', 'MEDIUM', 'HIGH', 'MINIMAL']
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidWorkspace(data, userId) {
      return data.keys().hasAll(['userId', 'currency', 'theme', 'seededSample', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'currency', 'theme', 'seededSample', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.currency in ['BRL', 'USD', 'EUR']
        && data.theme in ['light', 'dark']
        && data.seededSample is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccount(data, userId) {
      return data.keys().hasAll([
          'userId', 'name', 'type', 'institution', 'balance',
          'creditLimit', 'closingDay', 'dueDay', 'color', 'archived', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'name', 'type', 'institution', 'balance',
          'creditLimit', 'closingDay', 'dueDay', 'color', 'archived', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.type in ['checking', 'savings', 'wallet', 'investment', 'credit']
        && data.institution is string && data.institution.size() <= 80
        && data.balance is number
        && data.creditLimit is number && data.creditLimit >= 0
        && data.closingDay is number && data.closingDay >= 0 && data.closingDay <= 31
        && data.dueDay is number && data.dueDay >= 0 && data.dueDay <= 31
        && isValidHexColor(data.color)
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'type', 'icon', 'color', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'name', 'type', 'icon', 'color', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.type in ['income', 'expense']
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 40
        && isValidHexColor(data.color)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll([
          'userId', 'type', 'amount', 'description', 'categoryId', 'accountId',
          'toAccountId', 'date', 'status', 'isRecurring', 'recurrenceFrequency',
          'installmentGroupId', 'installmentNumber', 'installmentTotal', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'type', 'amount', 'description', 'categoryId', 'accountId',
          'toAccountId', 'date', 'status', 'isRecurring', 'recurrenceFrequency',
          'installmentGroupId', 'installmentNumber', 'installmentTotal', 'notes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && data.type in ['income', 'expense', 'transfer']
        && data.amount is number && data.amount > 0
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 140
        && isValidId(data.categoryId)
        && isValidId(data.accountId)
        && data.toAccountId is string && data.toAccountId.size() <= 128
        && (data.type != 'transfer' || (isValidId(data.toAccountId) && data.toAccountId != data.accountId))
        && isValidIsoDate(data.date)
        && data.status in ['paid', 'pending']
        && data.isRecurring is bool
        && data.recurrenceFrequency in ['none', 'monthly', 'weekly', 'yearly']
        && data.installmentGroupId is string && data.installmentGroupId.size() <= 128
        && data.installmentNumber is number && data.installmentNumber >= 0 && data.installmentNumber <= 360
        && data.installmentTotal is number && data.installmentTotal >= 0 && data.installmentTotal <= 360
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBudget(data, userId) {
      return data.keys().hasAll(['userId', 'categoryId', 'month', 'amount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'categoryId', 'month', 'amount', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && isValidId(data.categoryId)
        && isValidMonth(data.month)
        && data.amount is number && data.amount > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoal(data, userId) {
      return data.keys().hasAll([
          'userId', 'name', 'targetAmount', 'currentAmount', 'deadline', 'color', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'name', 'targetAmount', 'currentAmount', 'deadline', 'color', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.targetAmount is number && data.targetAmount > 0
        && data.currentAmount is number && data.currentAmount >= 0
        && isValidIsoDate(data.deadline)
        && isValidHexColor(data.color)
        && data.status in ['active', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAIConversation(data, userId) {
      return data.keys().hasAll([
          'userId', 'title', 'preview', 'messageCount', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'title', 'preview', 'messageCount', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.preview is string && data.preview.size() <= 220
        && data.messageCount is number && data.messageCount >= 0 && data.messageCount <= 10000
        && data.lastMessageAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAIMessage(data, userId, conversationId) {
      return data.keys().hasAll([
          'userId', 'conversationId', 'role', 'text', 'actionsSummary', 'modelProfileId', 'hasImage', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'conversationId', 'role', 'text', 'actionsSummary', 'modelProfileId', 'hasImage', 'createdAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && isValidId(data.conversationId)
        && data.conversationId == conversationId
        && data.role in ['user', 'assistant']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 12000
        && data.actionsSummary is list && data.actionsSummary.size() <= 25
        && data.modelProfileId is string && data.modelProfileId.size() <= 40
        && data.hasImage is bool
        && data.createdAt is timestamp;
    }

    // --- Admin-Controlled Global App Configuration ---
    match /appConfig/{configId} {
      allow list: if isPrimaryAdmin();
      allow get: if isValidId(configId) && configId == 'assistant' && isSignedIn();
      allow create: if isValidId(configId)
        && configId == 'assistant'
        && isAdmin()
        && isValidAssistantConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(configId)
        && configId == 'assistant'
        && isAdmin()
        && isValidAssistantConfig(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'profileId', 'modelId', 'thinkingLevel', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // --- Collection Match Rules ---
    match /users/{userId} {
      allow list: if isPrimaryAdmin();
      allow get: if isValidId(userId) && (isOwner(userId) || isPrimaryAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['currency', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['seededSample', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['currency', 'theme', 'seededSample', 'updatedAt'])
        );
      allow delete: if false;

      // Isolated PII subcollection
      match /private/{docId} {
        allow list: if isPrimaryAdmin();
        allow get: if isValidId(userId) && docId == 'profile' && (isOwner(userId) || isPrimaryAdmin());
        allow create: if isValidId(userId)
          && docId == 'profile'
          && isOwner(userId)
          && isValidPrivateProfile(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentWorkspaceExistsAfter(userId);
        allow update: if isValidId(userId)
          && docId == 'profile'
          && isOwner(userId)
          && isValidPrivateProfile(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt'])
          && parentWorkspaceExists(userId);
        allow delete: if false;
      }

      // Accounts & Credit Cards
      match /accounts/{accountId} {
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isPrimaryAdmin();
        allow get: if isValidId(accountId) && ((isOwner(userId) && parentWorkspaceExists(userId)) || isPrimaryAdmin());
        allow create: if isValidId(accountId)
          && isOwner(userId)
          && isValidAccount(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentWorkspaceExistsAfter(userId);
        allow update: if isValidId(accountId)
          && isOwner(userId)
          && isValidAccount(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'type', 'institution', 'balance', 'creditLimit', 'closingDay', 'dueDay', 'color', 'archived', 'updatedAt'
            ])
          )
          && parentWorkspaceExists(userId);
        allow delete: if isValidId(accountId) && isOwner(userId) && parentWorkspaceExists(userId);
      }

      // Categories
      match /categories/{categoryId} {
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isPrimaryAdmin();
        allow get: if isValidId(categoryId) && ((isOwner(userId) && parentWorkspaceExists(userId)) || isPrimaryAdmin());
        allow create: if isValidId(categoryId)
          && isOwner(userId)
          && isValidCategory(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentWorkspaceExistsAfter(userId);
        allow update: if isValidId(categoryId)
          && isOwner(userId)
          && isValidCategory(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'icon', 'color', 'updatedAt'])
          && parentWorkspaceExists(userId);
        allow delete: if isValidId(categoryId) && isOwner(userId) && parentWorkspaceExists(userId);
      }

      // Transactions Ledger
      match /transactions/{transactionId} {
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isPrimaryAdmin();
        allow get: if isValidId(transactionId) && ((isOwner(userId) && parentWorkspaceExists(userId)) || isPrimaryAdmin());
        allow create: if isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentWorkspaceExistsAfter(userId)
          && existsAfter(/databases/$(database)/documents/users/$(userId)/accounts/$(incoming().accountId))
          && (incoming().type != 'transfer' || existsAfter(/databases/$(database)/documents/users/$(userId)/accounts/$(incoming().toAccountId)));
        allow update: if isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'type', 'amount', 'description', 'categoryId', 'accountId', 'toAccountId',
              'date', 'status', 'isRecurring', 'recurrenceFrequency', 'notes', 'updatedAt'
            ])
          )
          && parentWorkspaceExists(userId);
        allow delete: if isValidId(transactionId) && isOwner(userId) && parentWorkspaceExists(userId);
      }

      // Monthly Budgets
      match /budgets/{budgetId} {
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isPrimaryAdmin();
        allow get: if isValidId(budgetId) && ((isOwner(userId) && parentWorkspaceExists(userId)) || isPrimaryAdmin());
        allow create: if isValidId(budgetId)
          && isOwner(userId)
          && isValidBudget(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentWorkspaceExistsAfter(userId)
          && existsAfter(/databases/$(database)/documents/users/$(userId)/categories/$(incoming().categoryId));
        allow update: if isValidId(budgetId)
          && isOwner(userId)
          && isValidBudget(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().categoryId == existing().categoryId
          && incoming().month == existing().month
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'updatedAt'])
          && parentWorkspaceExists(userId);
        allow delete: if isValidId(budgetId) && isOwner(userId) && parentWorkspaceExists(userId);
      }

      // Financial Goals (with terminal state locking on completed/cancelled)
      match /goals/{goalId} {
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isPrimaryAdmin();
        allow get: if isValidId(goalId) && ((isOwner(userId) && parentWorkspaceExists(userId)) || isPrimaryAdmin());
        allow create: if isValidId(goalId)
          && isOwner(userId)
          && isValidGoal(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentWorkspaceExistsAfter(userId);
        allow update: if isValidId(goalId)
          && isOwner(userId)
          && isValidGoal(incoming(), userId)
          && existing().status == 'active'
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['currentAmount', 'status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'targetAmount', 'currentAmount', 'deadline', 'color', 'status', 'updatedAt'])
          )
          && parentWorkspaceExists(userId);
        allow delete: if isValidId(goalId) && isOwner(userId) && parentWorkspaceExists(userId);
      }

      // Persisted AI Assistant Conversations
      match /aiConversations/{conversationId} {
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isPrimaryAdmin();
        allow get: if isValidId(conversationId) && ((isOwner(userId) && parentWorkspaceExists(userId)) || isPrimaryAdmin());
        allow create: if isValidId(conversationId)
          && isOwner(userId)
          && isValidAIConversation(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && incoming().lastMessageAt == request.time
          && parentWorkspaceExistsAfter(userId);
        allow update: if isValidId(conversationId)
          && isOwner(userId)
          && isValidAIConversation(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['preview', 'messageCount', 'lastMessageAt', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'preview', 'messageCount', 'lastMessageAt', 'updatedAt'])
          )
          && parentWorkspaceExists(userId);
        allow delete: if isValidId(conversationId) && isOwner(userId) && parentWorkspaceExists(userId);

        match /messages/{messageId} {
          allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isPrimaryAdmin();
          allow get: if isValidId(messageId) && isValidId(conversationId) && ((isOwner(userId) && parentWorkspaceExists(userId)) || isPrimaryAdmin());
          allow create: if isValidId(messageId)
            && isValidId(conversationId)
            && isOwner(userId)
            && isValidAIMessage(incoming(), userId, conversationId)
            && incoming().createdAt == request.time
            && parentWorkspaceExistsAfter(userId)
            && existsAfter(/databases/$(database)/documents/users/$(userId)/aiConversations/$(conversationId));
          allow update: if false;
          allow delete: if isValidId(messageId) && isValidId(conversationId) && isOwner(userId) && parentWorkspaceExists(userId);
        }
      }
    }
  }
}
